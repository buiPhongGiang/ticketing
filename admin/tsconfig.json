{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": { "viem": ["./node_modules/viem"], "viem/*": ["./node_modules/viem/*"] }
  },
  "include": ["src", "test", "e2e", "playwright.config.ts"]
}
